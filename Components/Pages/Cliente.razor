@page "/clientes"
@rendermode InteractiveServer
@using WebEmpresa.Models
@using WebEmpresa.Services
@inject ClientesService Servicio

<PageTitle>Clientes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <button class="btn btn-primary" @onclick="NuevoCliente">+ Agregar cliente</button>
</div>

@if (!string.IsNullOrEmpty(mensajeOk))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (cargando)
{
    <p><em>Cargando clientes...</em></p>
}
else if (clientes.Count == 0)
{
    <p class="text-muted">No hay clientes registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>CUI</th>
                    <th>NIT</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clientes)
                {
                    <tr>
                        <td>@c.Id_cliente</td>
                        <td>@c.CUI</td>
                        <td>@c.NIT</td>
                        <td>@c.Nombres</td>
                        <td>@c.Apellidos</td>
                        <td>@c.Direccion</td>
                        <td>@c.Telefono</td>
                        <td>@c.Fecha_nacimiento?.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(c)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(c)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ===== Modal agregar / editar ===== *@
@if (mostrarFormulario && actual is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="actual" OnValidSubmit="Guardar" FormName="formCliente">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(actual.Id_cliente == 0 ? "Agregar cliente" : "Editar cliente")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorFormulario))
                        {
                            <div class="alert alert-danger">@errorFormulario</div>
                        }
                        <ValidationSummary class="text-danger" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">CUI</label>
                                <InputText class="form-control" @bind-Value="actual.CUI" maxlength="13" />
                                <ValidationMessage For="() => actual.CUI" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="actual.NIT" maxlength="11" />
                                <ValidationMessage For="() => actual.NIT" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="actual.Nombres" />
                                <ValidationMessage For="() => actual.Nombres" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="actual.Apellidos" />
                                <ValidationMessage For="() => actual.Apellidos" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control" @bind-Value="actual.Direccion" />
                                <ValidationMessage For="() => actual.Direccion" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="actual.Telefono" maxlength="8" />
                                <ValidationMessage For="() => actual.Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" @bind-Value="actual.Fecha_nacimiento" />
                                <ValidationMessage For="() => actual.Fecha_nacimiento" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarFormulario" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===== Modal confirmar eliminación ===== *@
@if (clienteAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    ¿Seguro que deseas eliminar a <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>
                    (CUI @clienteAEliminar.CUI)? Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelarEliminar" disabled="@guardando">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@guardando">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Clientes> clientes = new();
    private Clientes? actual;
    private Clientes? clienteAEliminar;
    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;
    private string? mensajeOk;
    private string? mensajeError;
    private string? errorFormulario;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        var (datos, error) = await Servicio.ObtenerTodosAsync();
        clientes = datos;
        mensajeError = error;
        cargando = false;
    }

    private void NuevoCliente()
    {
        actual = new Clientes();
        errorFormulario = null;
        mostrarFormulario = true;
    }

    private void Editar(Clientes c)
    {
        actual = c.Clonar(); // se edita una copia para no alterar la lista si se cancela
        errorFormulario = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        actual = null;
        errorFormulario = null;
    }

    private async Task Guardar()
    {
        if (actual is null) return;

        // Validación de duplicados (CUI y NIT únicos)
        var cui = actual.CUI?.Trim();
        var nit = actual.NIT?.Trim().ToUpper();
        if (clientes.Any(c => c.Id_cliente != actual.Id_cliente && c.CUI == cui))
        {
            errorFormulario = "Ya existe un cliente registrado con ese CUI.";
            return;
        }
        if (clientes.Any(c => c.Id_cliente != actual.Id_cliente && c.NIT?.ToUpper() == nit))
        {
            errorFormulario = "Ya existe un cliente registrado con ese NIT.";
            return;
        }

        // Limpieza de datos
        actual.CUI = cui;
        actual.NIT = nit;
        actual.Nombres = actual.Nombres?.Trim();
        actual.Apellidos = actual.Apellidos?.Trim();
        actual.Direccion = actual.Direccion?.Trim();
        actual.Telefono = actual.Telefono?.Trim();

        guardando = true;
        var esNuevo = actual.Id_cliente == 0;
        var (ok, error) = esNuevo
            ? await Servicio.CrearAsync(actual)
            : await Servicio.ActualizarAsync(actual);
        guardando = false;

        if (!ok)
        {
            errorFormulario = error;
            return;
        }

        mensajeError = null;
        mensajeOk = esNuevo ? "Cliente agregado correctamente." : "Cliente actualizado correctamente.";
        CerrarFormulario();
        await CargarAsync();
    }

    private void PedirEliminar(Clientes c) => clienteAEliminar = c;

    private void CancelarEliminar() => clienteAEliminar = null;

    private async Task ConfirmarEliminar()
    {
        if (clienteAEliminar is null) return;

        guardando = true;
        var (ok, error) = await Servicio.EliminarAsync(clienteAEliminar.Id_cliente);
        guardando = false;
        clienteAEliminar = null;

        if (ok)
        {
            mensajeError = null;
            mensajeOk = "Cliente eliminado correctamente.";
        }
        else
        {
            mensajeOk = null;
            mensajeError = error;
        }
        await CargarAsync();
    }
}